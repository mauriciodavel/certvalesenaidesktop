{
  "name": "certifica-vale-desktop",
  "productName": "Certifica Vale",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "exceljs": "latest",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "br.com.certificavale.desktop",
    "productName": "Certifica Vale",
    "asar": true,
    "directories": {
      "output": "release-secure"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Certifica-Vale-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Certifica Vale"
    }
  }
}
