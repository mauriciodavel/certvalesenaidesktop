{
  "name": "certifica-vale-desktop",
  "productName": "Certifica Vale",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:init": "tsx server/scripts/init-db.ts",
    "test": "vitest run",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "node scripts/prepare-desktop-config.cjs && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "dotenv": "latest",
    "exceljs": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "latest",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "latest",
    "multer": "latest",
    "mysql2": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "br.com.certificavale.desktop",
    "productName": "Certifica Vale",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/desktop-config.env",
        "to": "desktop-config.env"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Certifica-Vale-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Certifica Vale"
    }
  }
}
